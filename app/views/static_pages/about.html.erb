<section class="bg-[#e9f7f7] min-h-screen px-4 py-12">
  <div class="max-w-3xl mx-auto bg-white rounded-3xl shadow-sm p-8 md:p-12">

    <h1 class="text-2xl md:text-3xl font-bold mb-8 text-center">
      <%= t("static_pages.about.title") %>
    </h1>

    <div class="space-y-6 text-gray-700 leading-relaxed text-sm md:text-base">

      <p>
        <%= t("static_pages.about.description") %>
      </p>

      <h2 class="font-bold text-lg mt-6">
        <%= t("static_pages.about.reason_title") %>
      </h2>
      <p>
        <%= t("static_pages.about.reason_body") %>
      </p>

      <h2 class="font-bold text-lg mt-6">
        <%= t("static_pages.about.features_title") %>
      </h2>
      <ul class="list-disc ml-6 space-y-2">
        <li><%= t("static_pages.about.features.easy_record") %></li>
        <li><%= t("static_pages.about.features.gentle_visualize") %></li>
        <li><%= t("static_pages.about.features.multi_device") %></li>
      </ul>

    </div>

  </div>
</section>