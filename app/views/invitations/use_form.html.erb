<section class="bg-[#e9f7f7] min-h-[calc(100vh-80px)] flex items-center justify-center px-4">
  <div class="w-full max-w-2xl bg-white rounded-2xl shadow-sm px-6 py-10 md:px-10">

    <!-- タイトル -->
    <h1 class="text-2xl md:text-3xl font-bold text-center mb-6">
      <%= t("invitations.use.title") %>
    </h1>

    <!-- フォーム -->
    <%= form_with url: invitations_use_path, method: :post, local: true do %>
      <div class="flex justify-center mb-8">
        <input
          type="text"
          name="code"
          required
          class="w-full max-w-md rounded-xl border border-gray-400 bg-[#e9f7f7] px-6 py-4 text-center text-lg tracking-widest
                 focus:outline-none focus:ring-2 focus:ring-cyan-300"
          placeholder="<%= t('invitations.use.placeholder') %>"
        >
      </div>

      <!-- 送信ボタン -->
      <div class="flex justify-center">
        <button
          type="submit"
          class="px-10 py-2 rounded-md bg-gray-200 border border-gray-500
                 text-gray-800 hover:bg-gray-300 transition">
          <%= t("invitations.use.submit") %>
        </button>
      </div>
    <% end %>

  </div>
</section>