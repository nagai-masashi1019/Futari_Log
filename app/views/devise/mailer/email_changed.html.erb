<p><%= t("devise.mailer.email_changed_view.greeting", email: @email) %></p>

<% if @resource.try(:unconfirmed_email?) %>
  <p>
    <%= t("devise.mailer.email_changed_view.unconfirmed_message") %>
  </p>

  <p>
    <%= t("devise.mailer.email_changed_view.new_email_label") %><br>
    <strong><%= @resource.unconfirmed_email %></strong>
  </p>
<% else %>
  <p>
    <%= t("devise.mailer.email_changed_view.confirmed_message") %>
  </p>
<% end %>

<p>
  <%= t("devise.mailer.email_changed_view.notice_message") %>
</p>