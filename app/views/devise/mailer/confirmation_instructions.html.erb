<p><%= t("devise.mailer.confirmation_instructions_view.greeting", email: @email) %></p>

<p>
  <%= t("devise.mailer.confirmation_instructions_view.thanks_message") %>
</p>

<p>
  <%= t("devise.mailer.confirmation_instructions_view.instruction_message") %>
</p>

<p style="margin: 24px 0;">
  <%= link_to t("devise.mailer.confirmation_instructions_view.confirm_button"),
        confirmation_url(@resource, confirmation_token: @token),
        style: "display:inline-block;padding:12px 20px;background:#14b8a6;color:#fff;text-decoration:none;border-radius:6px;" %>
</p>

<p>
  <%= t("devise.mailer.confirmation_instructions_view.closing_message") %>
</p>