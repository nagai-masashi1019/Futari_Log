<section class="bg-[#e9f7f7] min-h-[calc(100vh-80px)] flex items-center justify-center px-4">
  <div class="w-full max-w-xl bg-white rounded-2xl shadow-sm px-6 py-10 md:px-10">

    <h1 class="text-2xl md:text-3xl font-bold text-center mb-8">
      新規登録
    </h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

      <!-- ニックネーム -->
      <div class="mb-5 text-left">
        <%= f.label :nickname,
              raw('表示名（ニックネーム） <span class="text-red-500 text-xs ml-1">必須</span>'),
              class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.text_field :nickname,
              required: true,
              class: "w-full rounded-md border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-cyan-300" %>
      </div>

      <!-- メール -->
      <div class="mb-5 text-left">
        <%= f.label :email,
              raw('メールアドレス <span class="text-red-500 text-xs ml-1">必須</span>'),
              class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.email_field :email,
              required: true,
              class: "w-full rounded-md border border-gray-300 px-4 py-2 focus:ring-2 focus:ring-cyan-300" %>
      </div>

      <!-- パスワード -->
      <div class="mb-5 text-left relative">
        <%= f.label :password, "パスワード", class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.password_field :password,
              required: true,
              placeholder: "6文字以上で入力",
              id: "password-field",
              class: "w-full rounded-md border border-gray-300 px-4 py-2 pr-10 focus:ring-2 focus:ring-cyan-300" %>

        <button type="button"
                class="absolute right-3 top-9 text-gray-500"
                onclick="togglePassword('password-field', this)">
          <i class="fa-solid fa-eye"></i>
        </button>
      </div>

      <!-- パスワード確認 -->
      <div class="mb-6 text-left relative">
        <%= f.label :password_confirmation,
              raw('パスワード（確認） <span class="text-red-500 text-xs ml-1">必須</span>'),
              class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.password_field :password_confirmation,
              required: true,
              id: "password-confirm-field",
              class: "w-full rounded-md border border-gray-300 px-4 py-2 pr-10 focus:ring-2 focus:ring-cyan-300" %>

        <span onclick="togglePassword('password-confirm-field', this)"
              class="absolute right-3 top-9 text-gray-500"
              onclick="togglePassword('password-field', this)">
        <i class="fa-solid fa-eye"></i></span>
      </div>

      <div class="flex justify-center mb-6">
        <%= f.submit "登録",
              class: "px-8 py-2 rounded-md bg-gray-200 border border-gray-500 text-gray-800 hover:bg-gray-300 transition" %>
      </div>

    <% end %>
  </div>
</section>