<section class="bg-[#e9f7f7] min-h-[calc(100vh-80px)] flex items-center justify-center px-4">
  <div class="w-full max-w-xl bg-white rounded-2xl shadow-sm px-6 py-10 md:px-10">

    <!-- タイトル -->
    <h1 class="text-2xl md:text-3xl font-bold text-center mb-10">
      <%= t("devise.registrations.password_edit.title") %>
    </h1>

    <p class="text-sm text-gray-600 text-center mb-8">
      <%= t("devise.registrations.password_edit.description") %>
    </p>

    <%= form_for(resource,
          as: resource_name,
          url: registration_path(resource_name),
          html: { method: :put }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- 新しいパスワード -->
      <div class="mb-6">
        <%= f.label :password,
              t("devise.registrations.password_edit.new_password_label"),
              class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.password_field :password,
              autocomplete: "new-password",
              class: "w-full rounded-md border border-gray-300 px-4 py-2
                      focus:outline-none focus:ring-2 focus:ring-cyan-300" %>

        <% if @minimum_password_length %>
          <p class="text-xs text-gray-500 mt-1">
            ※ <%= t("devise.registrations.password_edit.minimum_length",
                    count: @minimum_password_length) %>
          </p>
        <% end %>
      </div>

      <!-- パスワード確認 -->
      <div class="mb-6">
        <%= f.label :password_confirmation,
              t("devise.registrations.password_edit.password_confirmation_label"),
              class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.password_field :password_confirmation,
              autocomplete: "new-password",
              class: "w-full rounded-md border border-gray-300 px-4 py-2
                      focus:outline-none focus:ring-2 focus:ring-cyan-300" %>
      </div>

      <!-- 現在のパスワード -->
      <div class="mb-10">
        <%= f.label :current_password,
              t("devise.registrations.password_edit.current_password_label"),
              class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.password_field :current_password,
              autocomplete: "current-password",
              class: "w-full rounded-md border border-gray-300 px-4 py-2
                      focus:outline-none focus:ring-2 focus:ring-cyan-300" %>
      </div>

      <!-- 送信 -->
      <div class="flex justify-center">
        <%= f.submit t("devise.registrations.password_edit.submit"),
              class: "px-10 py-2 rounded-md bg-gray-200
                      border border-gray-500 text-gray-800
                      hover:bg-gray-300 transition" %>
      </div>

    <% end %>

    <!-- 戻る -->
    <div class="flex justify-center mt-8 text-sm text-gray-700">
      <%= link_to t("devise.registrations.password_edit.back_to_account"),
            settings_path,
            class: "underline hover:text-gray-900" %>
    </div>

  </div>
</section>