<section class="bg-[#e9f7f7] min-h-[calc(100vh-80px)] flex items-center justify-center px-4">
  <div class="w-full max-w-xl bg-white rounded-2xl shadow-sm px-6 py-10 md:px-10">

    <!-- タイトル -->
    <h1 class="text-2xl md:text-3xl font-bold text-center mb-10">
      <%= t("devise.passwords.custom_edit.title") %>
    </h1>

    <%= form_for(resource, as: resource_name,
          url: password_path(resource_name),
          html: { method: :put }) do |f| %>

      <%= f.hidden_field :reset_password_token %>

      <!-- 新パスワード -->
      <div class="mb-6 text-left relative">
        <%= f.label :password,
              t("devise.passwords.custom_edit.new_password"),
              class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.password_field :password,
              id: "new-password",
              class: "w-full rounded-md border border-gray-300 px-4 py-2 pr-10 focus:ring-2 focus:ring-cyan-300" %>

        <button type="button"
                class="absolute right-3 top-9 text-gray-500"
                onclick="togglePassword('new-password', this)">
          <i class="fa-solid fa-eye"></i>
        </button>
      </div>

      <!-- 確認 -->
      <div class="mb-10 relative">
        <%= f.label :current_password,
              t("devise.passwords.custom_edit.current_password"),
              class: "block text-sm font-medium text-gray-700 mb-1" %>

        <%= f.password_field :current_password,
              id: "current-password",
              autocomplete: "current-password",
              class: "w-full rounded-md border border-gray-300 px-4 py-2 pr-10 focus:ring-2 focus:ring-cyan-300" %>

        <button type="button"
                class="absolute right-3 top-9 text-gray-500"
                onclick="togglePassword('current-password', this)">
          <i class="fa-solid fa-eye"></i>
        </button>
      </div>

    <% end %>

    <!-- 下部リンク -->
    <div class="flex justify-center text-sm text-gray-700">
      <%= link_to t("devise.passwords.custom_edit.back_to_login"),
            new_user_session_path,
            class: "underline hover:text-gray-900" %>
    </div>

  </div>
</section>