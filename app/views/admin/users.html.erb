<h1>ユーザー一覧</h1>

<table border="1">
  <tr>
    <th>ID</th>
    <th>Email</th>
    <th>Nickname</th>
    <th>Created</th>
    <th></th>
  </tr>

  <% @users.each do |user| %>
    <tr>
      <td><%= user.id %></td>
      <td><%= user.email %></td>
      <td><%= user.nickname %></td>
      <td><%= user.created_at %></td>
      <td>
        <%= button_to "削除",
            "/admin/users/#{user.id}",
            method: :delete,
            data: { confirm: "本当に削除しますか？" } %>
      </td>
    </tr>
  <% end %>
</table>