<% if user_signed_in? %>
<div class="bg-[#e9f7f7] min-h-screen flex overflow-hidden">
  <%= render "shared/sidebar_user" %>

  <div class="flex-1 px-4 md:px-10 py-8">
    <div class="md:hidden mb-6">
      <button id="sidebar-toggle"
        class="flex items-center gap-2 border border-gray-300 rounded-lg px-3 py-2 bg-white shadow-sm text-gray-700">
        ☰ メニュー
      </button>
    </div>

    <h1 class="text-2xl font-bold text-center mb-10">
      通知設定
    </h1>

    <div class="max-w-md mx-auto bg-white p-8 rounded-2xl shadow">
      <%= form_with model: @user, url: notification_settings_path, method: :patch do |f| %>

        <div class="mb-6">
          <%= f.check_box :notify_on_mood %>
          <%= f.label :notify_on_mood, "ごきげん記録の通知を受け取る" %>
        </div>

        <div class="mb-6">
          <%= f.check_box :notify_on_thanks %>
          <%= f.label :notify_on_thanks, "ありがとう投稿の通知を受け取る" %>
        </div>

        <div class="text-center">
          <%= f.submit "保存", class: "px-6 py-3 bg-gray-800 text-white rounded-full" %>
        </div>

      <% end %>
    </div>
  </div>
</div>
<% end %>
