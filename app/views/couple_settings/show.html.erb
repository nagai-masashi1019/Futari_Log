<% if user_signed_in? %>
  <div class="bg-[#e9f7f7] min-h-screen flex overflow-hidden">
    <%= render "shared/sidebar_user" %>

    <div id="content-wrapper" class="flex-1 transition-transform duration-300">
      <main class="px-4 md:px-10 py-8 max-w-full overflow-x-hidden">

        <!-- ☰（スマホ） -->
        <div class="md:hidden mb-6">
          <button id="sidebar-toggle"
            class="flex items-center gap-2 border border-gray-300 rounded-lg px-3 py-2 bg-white shadow-sm text-gray-700">
            <span class="text-xl">☰</span>
            <span class="text-sm"><%= t("settings.show.menu") %></span>
          </button>
        </div>

        <section class="max-w-xl mx-auto bg-white rounded-3xl shadow-sm px-6 py-10">
          <h1 class="text-xl font-bold text-center mb-8">
            <%= t("settings.show.couple") %>
          </h1>

          <% if @partner.present? %>
            <!-- パートナー表示名変更 -->
            <%= form_with model: @couple_user,
                  url: couple_settings_path,
                  method: :patch,
                  local: true do |f| %>

              <div class="mb-6">
                <label class="block font-bold mb-2">
                  <%= t("couple_settings.show.partner_nickname_label") %>
                </label>

                <%= f.text_field :partner_nickname,
                      class: "w-full border rounded-lg px-4 py-2",
                      placeholder: @partner.nickname %>
              </div>

              <div class="text-center">
                <%= f.submit t("couple_settings.show.update"),
                      class: "px-8 py-3 rounded-full bg-pink-500 text-white font-bold hover:bg-pink-600 transition" %>
              </div>
            <% end %>

            <!-- カップル解除 -->
            <div class="mt-12 border-t pt-8">
              <h2 class="text-sm font-bold text-red-500 mb-4 text-center">
                <%= t("couple_settings.show.breakup_title") %>
              </h2>

              <p class="text-xs text-gray-500 text-center mb-6 leading-relaxed">
                <%= t("couple_settings.show.breakup_description_html") %>
              </p>

              <div class="text-center">
                <%= button_to t("couple_settings.show.breakup_button"),
                      couple_settings_path,
                      method: :delete,
                      data: {
                        turbo_confirm: t("couple_settings.show.breakup_confirm")
                      },
                      class: "
                        px-6 py-3
                        rounded-full
                        bg-red-500
                        text-white
                        font-bold
                        hover:bg-red-600
                        transition
                      " %>
              </div>
            </div>

          <% else %>
            <p class="text-center text-gray-500">
              <%= t("couple_settings.show.not_set") %>
            </p>
          <% end %>
        </section>

      </main>
    </div>
  </div>
<% end %>