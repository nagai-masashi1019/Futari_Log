<header class="w-full bg-white border-b">
  <div class="flex items-center justify-between px-4 md:px-8 py-3">

    <!-- ロゴ（左端・控えめ） -->
    <%= link_to(current_user.couples.exists? ? root_path : couples_onboarding_path) do %>
      <%= image_tag "5442aa2a-9377-4f2d-ba76-87585137722f.png",
            class: "h-9 md:h-11" %>
    <% end %>

    <!-- PCナビ（右端） -->
    <nav class="hidden md:flex items-center gap-6">

      <% unread_count = current_user.notifications.unread.count %>

      <!-- 通知ベル -->
      <%= link_to notifications_path, class: "relative text-xl" do %>
        🔔
        <% if unread_count > 0 %>
          <span class="absolute -top-2 -right-3 bg-red-500 text-white text-xs rounded-full px-2 py-0.5">
            <%= unread_count %>
          </span>
        <% end %>
      <% end %>

      <!-- ログアウト -->
      <%= button_to "ログアウト",
            destroy_user_session_path,
            method: :delete,
            class: "text-sm text-gray-700 hover:text-gray-900" %>
    </nav>

    <!-- モバイルメニュー -->
    <button id="mobile-menu-button" class="md:hidden">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- モバイルナビ -->
  <div id="mobile-menu" class="hidden md:hidden border-t bg-white">
    <div class="flex flex-col items-center py-4 gap-4">

      <% unread_count = current_user.notifications.unread.count %>

      <!-- モバイル通知ベル -->
      <%= link_to notifications_path, class: "relative text-xl" do %>
        🔔 通知
        <% if unread_count > 0 %>
          <span class="absolute -top-2 -right-3 bg-red-500 text-white text-xs rounded-full px-2 py-0.5">
            <%= unread_count %>
          </span>
        <% end %>
      <% end %>

      <!-- ログアウト -->
      <%= button_to "ログアウト",
            destroy_user_session_path,
            method: :delete,
            class: "text-gray-700" %>
    </div>
  </div>
</header>
